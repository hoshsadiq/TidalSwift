#!/usr/bin/env bash
#MISE description="Build TidalSwift.app (unsigned)"
#MISE depends=["generate"]
# Env overrides: CONFIGURATION (default Debug), MARKETING_VERSION, CURRENT_PROJECT_VERSION (empty = project values)
set -eo pipefail

args=()
if [ -n "${MARKETING_VERSION:-}" ]; then
	args+=(MARKETING_VERSION="$MARKETING_VERSION")
fi
if [ -n "${CURRENT_PROJECT_VERSION:-}" ]; then
	args+=(CURRENT_PROJECT_VERSION="$CURRENT_PROJECT_VERSION")
fi

xcodebuild \
	-project TidalSwift.xcodeproj \
	-scheme TidalSwift \
	-configuration "${CONFIGURATION:-Debug}" \
	-derivedDataPath .build/DerivedData \
	CODE_SIGNING_ALLOWED=NO \
	"${args[@]}" \
	build | xcbeautify --quiet
