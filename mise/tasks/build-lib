#!/usr/bin/env bash
#MISE description="Build TidalSwiftLib package"
# Builds the package on its own, without Xcode, the same way CI's library job does.
set -Eeuo pipefail

# shellcheck source=mise/tasks/_lib.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/_lib.sh"

main() {
	task_in_lib swift build
}

main "$@"
