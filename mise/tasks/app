#!/usr/bin/env bash
#MISE description="Launch the app from this checkout, tidying stale URL-scheme registrations first"
#MISE depends=["build"]
# TidalSwift claims the tidal:// scheme, and so does every build copy of the app that
# has ever been launched: earlier worktree builds, the Periphery cache, an installed
# copy. LaunchServices chooses among them when the login callback arrives, and a path
# that no longer exists can swallow it, which looks like a login that opens the wrong
# app or never returns. This removes the other copies from the registry, then launches
# the build in this checkout, which claims the scheme for itself at launch.
#
# Env overrides: CONFIGURATION (default Debug), TIDY_ONLY (tidy the registry only).
set -eo pipefail

readonly LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
readonly BUNDLE_NAME="TidalSwift.app"
readonly APP_PATH=".build/DerivedData/Build/Products/${CONFIGURATION:-Debug}/${BUNDLE_NAME}"

if [[ ! -x "$LSREGISTER" ]]; then
	printf 'lsregister not found at %s\n' "$LSREGISTER" >&2
	exit 1
fi
if [[ ! -d "$APP_PATH" ]]; then
	printf 'No build at %s — run: mise run build\n' "$APP_PATH" >&2
	exit 1
fi

# Absolute path of the copy being launched, so it is never the one removed.
HERE="$(cd -- "$(dirname -- "$APP_PATH")" && pwd -P)/$BUNDLE_NAME"
readonly HERE

# Every registered copy of this app, taken from the LaunchServices dump. The dump
# pairs a `path:` line with the `bindings:` line that follows it, so the path is
# held until a binding for this scheme appears.
registered_paths() {
	"$LSREGISTER" -dump 2>/dev/null | awk '
		/^[[:space:]]*path:/ {
			p = $0
			sub(/^[[:space:]]*path:[[:space:]]*/, "", p)
			sub(/[[:space:]]*\(0x[0-9a-fA-F]+\)[[:space:]]*$/, "", p)
			next
		}
		/^[[:space:]]*bindings:/ && /tidal:/ {
			if (p != "") print p
			p = ""
		}
	' | sort -u
}

removed=0
kept_other=0
while IFS= read -r path; do
	[[ -n "$path" ]] || continue
	# Only this app's own copies are touched: TIDAL.app and anything else that
	# claims the scheme keep their registration.
	[[ "$path" == */"$BUNDLE_NAME" ]] || continue
	if [[ "$path" == "$HERE" ]]; then
		continue
	fi
	if "$LSREGISTER" -u "$path" >/dev/null 2>&1; then
		printf 'unregistered  %s\n' "$path"
		removed=$((removed + 1))
	else
		kept_other=$((kept_other + 1))
	fi
done < <(registered_paths)

printf '%s stale registration(s) removed from %s\n' "$removed" "$BUNDLE_NAME"
if (( kept_other > 0 )); then
	printf '%s could not be removed (already gone, or not removable)\n' "$kept_other"
fi

if [[ -n "${TIDY_ONLY:-}" ]]; then
	printf 'TIDY_ONLY set, not launching\n'
	exit 0
fi

# The app claims tidal:// for itself on launch, which is what makes the callback
# come back here rather than to one of the copies just removed.
open "$APP_PATH"
printf 'launched %s\n' "$APP_PATH"
